{
  "name": "siao-landing",
  "main": "../../workers/web/src/index.ts",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./build/jaspr",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "services": [{ "binding": "API", "service": "siao-api" }],
  "observability": { "enabled": true }
}
